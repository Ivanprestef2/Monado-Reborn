#!/bin/sh
# [XCDE] T-LINUX-APPIMAGE: the AppImage mount is read-only, so everything the game and the launcher write (xcde.ini,
# cache/, saves, logs in build/) lives outside it. <data>/build/linux/monado points to the mounted executable.
# --play can remember a directory via <data>/targets. The launcher remembers an explicit dump in xcde.ini.
#   ./Monado-x86_64.AppImage [dump directory]       launcher (or the game directly if xcde.ini has skip_launcher = 1)
#   ./Monado-x86_64.AppImage --play [dump directory] the game directly
#   ./Monado-x86_64.AppImage --launcher [dump dir]   force the launcher even when skip_launcher = 1
#   ./Monado-x86_64.AppImage --game <dump directory or .nup> the game directly, without the targets link (RecompLauncher)
#   ./Monado-x86_64.AppImage --prepare <builder args> the first-start game code builder (RecompLauncher's setup step)
# RecompLauncher (recomplauncher.json) unpacks the AppImage into the game's install folder and passes that folder as
# MONADO_DATA_ROOT, so Linux keeps the Windows package's layout (xcde.ini, save/ and gamebuild/ in the install folder).
# The dump: the argument, else MONADO_GAME_ROOT, else targets/ next to the AppImage, else the remembered dump.
# The data folder (GitHub #88): MONADO_DATA_ROOT, else a monado-data folder next to the AppImage when there is one
# (portable: everything stays beside it), else $XDG_DATA_HOME/monado (~/.local/share/monado, as runtime/platform/linux.c).
# Before, it was $XDG_DATA_HOME/lasrecomp, the folder LASRecomp's Link's Awakening recomp uses too: one that holds
# Monado's xcde.ini keeps being used while there is no monado folder, so an update never loses saves or settings.
set -eu
appdir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# MONADO_APPIMAGE_CA_BUNDLE: OpenSSL is bundled from the build runner (Ubuntu), whose default
# CA path is /usr/lib/ssl. Arch/SteamOS use /etc/ssl and Fedora /etc/pki/tls, so point it at
# the host's bundle; otherwise TLS checks fail with "unable to get local issuer certificate"
# (the FSR 4 Lite preparation downloads AMD's upscaler DLL over HTTPS).
if [ -z "${SSL_CERT_FILE:-}" ]; then
  for c in /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt /etc/ssl/cert.pem /etc/ssl/certs/ca-bundle.crt /etc/ssl/ca-bundle.pem; do
    if [ -f "$c" ]; then export SSL_CERT_FILE="$c"; break; fi
  done
fi
export LD_LIBRARY_PATH="$appdir/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# FSR 4 Lite's model files: packaged (a local build with --fsr4-assets), else the data folder's fsr4/, which the
# launcher's "Prepare FSR 4 Lite" fills on this PC (runtime/nvn/vulkan/fsr4.c looks there by itself)
if [ -f "$appdir/usr/share/monado/fsr4/lite/t1080_m0/initializer.bin" ]; then
  export MONADO_FSR4_ASSET_DIR="${MONADO_FSR4_ASSET_DIR:-$appdir/usr/share/monado/fsr4}"
fi
if [ -f "$appdir/usr/share/monado/dlss/libnvidia-ngx-dlss.so.310.9.1" ]; then
  export MONADO_DLSS_DIR="${MONADO_DLSS_DIR:-$appdir/usr/share/monado/dlss}"
fi
export XCDE_VARIANTS_SEED="${XCDE_VARIANTS_SEED:-$appdir/usr/share/monado/variants_seed.bin}"
# Release AppImages: FSR 4 Lite's preparation tool (the launcher's "Prepare FSR 4 Lite")
if [ -x "$appdir/usr/share/monado/fsr4prep/monado-fsr4prep" ]; then
  export XCDE_FSR4PREP_DIR="${XCDE_FSR4PREP_DIR:-$appdir/usr/share/monado/fsr4prep}"
fi
# Release AppImages: the first-start game code builder (the launcher runs it once; the result goes to the data folder)
if [ -f "$appdir/usr/share/monado/gamebuild/link.json" ]; then
  export XCDE_GAMEBUILD_DIR="${XCDE_GAMEBUILD_DIR:-$appdir/usr/share/monado/gamebuild}"
fi
if [ "${1:-}" = --prepare ]; then
  # The builder takes its own arguments (--root, --out) and finds its resources beside itself; with --precompile it
  # then precompiles the shaders with the game, named here.
  shift
  export MONADO_GAME_EXE="$appdir/usr/bin/monado"
  exec "$appdir/usr/share/monado/gamebuild/monado-gamebuild" "$@"
fi
direct=
game_opt=
force_launcher=
case "${1:-}" in
  --play) direct=1; shift;;
  --game) direct=1; game_opt=1; shift;;
  --launcher) force_launcher=1; shift;;
esac
case "${1:-}" in
  -h|--help) echo "usage: ${APPIMAGE:-AppRun} [--play | --launcher | --game <dump directory or .nup> | --prepare <builder args>] [dump directory]"; exit 0;;
esac
root=${1:-${MONADO_GAME_ROOT:-}}
if [ "$#" -gt 0 ]; then shift; fi
if [ -n "$game_opt" ] && [ -z "$root" ]; then echo "--game needs the dump directory (exefs/ + romfs/)" >&2; exit 2; fi
nearby_dump=
if [ -z "$root" ] && [ -n "${APPIMAGE:-}" ] && [ -d "$(dirname -- "$APPIMAGE")/targets" ]; then
  nearby_dump="$(dirname -- "$APPIMAGE")/targets"
  case "$nearby_dump" in /*) ;; *) nearby_dump="$PWD/$nearby_dump";; esac
fi
case "$root" in ""|/*) ;; *) root="$PWD/$root";; esac
data=${MONADO_DATA_ROOT:-}
if [ -z "$data" ] && [ -n "${APPIMAGE:-}" ] && [ -d "$(dirname -- "$APPIMAGE")/monado-data" ]; then
  data="$(dirname -- "$APPIMAGE")/monado-data"
fi
if [ -z "$data" ]; then
  case "${XDG_DATA_HOME:-}" in /*) base="$XDG_DATA_HOME";; *) base="${HOME:?HOME must be set}/.local/share";; esac
  data="$base/monado"
  if [ ! -e "$data" ] && [ -f "$base/lasrecomp/xcde.ini" ]; then data="$base/lasrecomp"; fi
fi
mkdir -p -- "$data/build/linux"
data=$(CDPATH= cd -- "$data" && pwd)
export LARECOMP_DATA_ROOT="$data"
ini="${XCDE_INI:-xcde.ini}"
ini_value() {
  [ -f "$ini" ] || return 0
  awk -v key="$1" '
    NR == 1 { sub(/^\357\273\277/, "") }
    {
      eq = index($0, "=")
      if (!eq) next
      k = substr($0, 1, eq - 1); gsub(/^[ \t]+|[ \t]+$/, "", k)
      if (k == key) {
        v = substr($0, eq + 1); gsub(/^[ \t]+|[ \t\r]+$/, "", v)
        val = v
      }
    }
    END { if (length(val) > 0) print val }
  ' "$ini"
}
is_nup() {
  [ -f "$1" ] && [ "$(head -c 4 -- "$1" 2>/dev/null)" = "$(printf 'NUP\001')" ]
}

ln -sfn -- "$appdir/usr/bin/monado" "$data/build/linux/monado" 2>/dev/null || true
cd -- "$data"
dump=
new_dump=
if [ -z "$root" ]; then
  remembered=$(ini_value game_dump)
  if { [ -f "$remembered/exefs/main" ] && [ -d "$remembered/romfs" ]; } || is_nup "$remembered"; then
    dump="$remembered"
  else
    root="$nearby_dump"
  fi
fi
if { [ -n "$game_opt" ] || [ -z "$direct" ]; } && is_nup "$root"; then
  # [XCDE] T280: .nup packages stay in place.
  dump="$(CDPATH= cd -- "$(dirname -- "$root")" && pwd -P)/$(basename -- "$root")"
  new_dump=1
elif [ -n "$root" ]; then
  [ -f "$root/exefs/main" ] && [ -d "$root/romfs" ] || { echo "$root must contain exefs/main and romfs/ (your dump)" >&2; exit 2; }
  dump=$(CDPATH= cd -- "$root" && pwd -P)
  new_dump=1
  # Keep the existing --play shortcut for later launches. -T prevents ln from
  # creating a child link inside a real targets directory.
  if [ -n "$direct" ] && [ -z "$game_opt" ] &&
     { [ -L "$data/targets" ] || [ ! -e "$data/targets" ]; } &&
     [ "$(CDPATH= cd -- "$data/targets" 2>/dev/null && pwd -P)" != "$dump" ]; then
    ln -sfnT -- "$dump" "$data/targets"
  fi
fi
if [ -z "$direct" ] && [ -z "$force_launcher" ]; then
  skip_launcher=$(ini_value skip_launcher)
  if { [ "$skip_launcher" = 1 ] || [ "$skip_launcher" = true ]; } &&
     { [ -n "$dump" ] || [ -f targets/exefs/main ]; }; then
    build_dir=gamebuild
    in_dump=$(ini_value gamebuild_in_dump)
    if [ "$in_dump" = 1 ] || [ "$in_dump" = true ]; then
      build_root=${dump:-targets}
      if [ -f "$build_root" ]; then build_root=$(dirname -- "$build_root"); fi
      build_dir="$build_root/gamebuild"
    fi
    # A release needs a compatible game library from the first-start builder.
    if [ -z "${XCDE_GAMEBUILD_DIR:-}" ] || [ -f "$appdir/usr/bin/lasgame.so" ] || (
      [ -f "$build_dir/lasgame.so" ] && [ -s "$build_dir/lasgame.so.id" ] && [ -s "$XCDE_GAMEBUILD_DIR/gamelib-id.txt" ] &&
      [ "$(tr -d '\r\n ' < "$build_dir/lasgame.so.id")" = "$(tr -d '\r\n ' < "$XCDE_GAMEBUILD_DIR/gamelib-id.txt")" ]
    ); then
      direct=1
    fi
  fi
fi
if [ -z "$direct" ]; then
  if [ -n "$force_launcher" ]; then set -- --launcher "$@"; fi
  if [ -n "$new_dump" ]; then
    exec "$appdir/usr/bin/monado-launcher" --dump "$dump" "$@"
  fi
  exec "$appdir/usr/bin/monado-launcher" "$@"
fi
if [ -n "$game_opt" ]; then exec "$appdir/usr/bin/monado" --game "$dump" "$@"; fi
if [ -n "$dump" ]; then exec "$appdir/usr/bin/monado" "$dump" "$@"; fi
[ -f targets/exefs/main ] || { echo "No game dump: pass its directory once (it is remembered)" >&2; exit 2; }
exec "$appdir/usr/bin/monado" targets "$@"
